<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Keypad">
        <item name="android:layout_width">74dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/btn_option</item>
        <item name="android:textColor">@color/btn_option_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="KeypadWide">
        <item name="android:layout_width">98dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/btn_option</item>
        <item name="android:textColor">@color/btn_option_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StepBtn">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/btn_option</item>
        <item name="android:textColor">@color/btn_option_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ExitBtn">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/btn_option</item>
        <item name="android:textColor">@color/btn_option_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ExitBtnDanger" parent="ExitBtn">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="ActionBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:background">@drawable/btn_option</item>
        <item name="android:textColor">@color/btn_option_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
