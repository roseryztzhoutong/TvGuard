<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingStart="34dp"
    android:paddingEnd="34dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="退出与关闭"
        android:textColor="@color/gold"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="密码已经验证过了。选一种，方向键移动、按确定执行。"
        android:textColor="@color/dim_text"
        android:textSize="12sp" />

    <!-- 一、临时停止 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一、今天先停掉"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="不再弹题，重启电视也不会自动恢复。答题记录和所有设置都留着，想开随时开。"
                android:textColor="@color/dim_text"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStop"
            style="@style/ExitBtn"
            android:text="停止" />
    </LinearLayout>

    <!-- 二、关闭并解除防护 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="二、关掉，并解除防卸载"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="停掉答题，同时取消设备管理员、放开卸载限制。之后可以在系统设置里正常删掉。记录保留。"
                android:textColor="@color/dim_text"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRelease"
            style="@style/ExitBtn"
            android:text="关闭" />
    </LinearLayout>

    <!-- 三、卸载 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="三、卸载并清除全部数据"
                android:textColor="@color/warn_red"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUninstallDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="先解除全部防护，再跳系统卸载。答题记录、设置、密码会一起没掉，且找不回来。"
                android:textColor="@color/dim_text"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUninstall"
            style="@style/ExitBtnDanger"
            android:text="卸载" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMsg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@color/gold"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnBack"
        style="@style/ExitBtn"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="返回，不退出" />
</LinearLayout>
