# 统一换行符，避免 Windows 提交后 Linux/CI 上看整文件都是改动
* text=auto eol=lf

# 批处理必须保持 CRLF，否则 cmd 解析会出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jks binary
*.keystore binary
*.apk binary
*.jar binary

# 题库是纯数据，统一 LF，diff 才看得懂
*.json text eol=lf
